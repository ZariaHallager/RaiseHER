# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# Clerk — Expo (mobile)
# Get from https://dashboard.clerk.com/~/api-keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Convex deployment URL
# Run `npx convex dev` to get this value (auto-written to .env.local by convex CLI)
EXPO_PUBLIC_CONVEX_URL=https://REPLACE_ME.convex.cloud

# Google Gemini API key (server-side only — used inside Convex actions, NEVER expose to client)
# Satisfies "at least one Google Cloud product" hackathon requirement.
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_ME
