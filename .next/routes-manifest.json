{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/share/[token]",
      "regex": "^/share/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/share/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/case-files",
      "regex": "^/([^/]+?)/case\\-files(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/case\\-files(?:/)?$"
    },
    {
      "page": "/[locale]/case-files/[caseFileId]",
      "regex": "^/([^/]+?)/case\\-files/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPcaseFileId": "nxtPcaseFileId"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/case\\-files/(?<nxtPcaseFileId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/circle",
      "regex": "^/([^/]+?)/circle(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/circle(?:/)?$"
    },
    {
      "page": "/[locale]/pay-gap",
      "regex": "^/([^/]+?)/pay\\-gap(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/pay\\-gap(?:/)?$"
    },
    {
      "page": "/[locale]/pay-gap/result",
      "regex": "^/([^/]+?)/pay\\-gap/result(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/pay\\-gap/result(?:/)?$"
    },
    {
      "page": "/[locale]/pricing",
      "regex": "^/([^/]+?)/pricing(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/pricing(?:/)?$"
    },
    {
      "page": "/[locale]/privacy",
      "regex": "^/([^/]+?)/privacy(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/privacy(?:/)?$"
    },
    {
      "page": "/[locale]/profile",
      "regex": "^/([^/]+?)/profile(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/profile(?:/)?$"
    },
    {
      "page": "/[locale]/rehearsal",
      "regex": "^/([^/]+?)/rehearsal(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/rehearsal(?:/)?$"
    },
    {
      "page": "/[locale]/settings",
      "regex": "^/([^/]+?)/settings(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/settings(?:/)?$"
    },
    {
      "page": "/[locale]/settings/privacy",
      "regex": "^/([^/]+?)/settings/privacy(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/settings/privacy(?:/)?$"
    },
    {
      "page": "/[locale]/sign-in/[[...sign-in]]",
      "regex": "^/([^/]+?)/sign\\-in(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPsignin": "nxtPsign-in"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/sign\\-in(?:/(?<nxtPsignin>.+?))?(?:/)?$"
    },
    {
      "page": "/[locale]/sign-up/[[...sign-up]]",
      "regex": "^/([^/]+?)/sign\\-up(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPsignup": "nxtPsign-up"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/sign\\-up(?:/(?<nxtPsignup>.+?))?(?:/)?$"
    },
    {
      "page": "/[locale]/terms",
      "regex": "^/([^/]+?)/terms(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/terms(?:/)?$"
    },
    {
      "page": "/[locale]/wins",
      "regex": "^/([^/]+?)/wins(?:/)?$",
      "routeKeys": {
        "nxtPlocale": "nxtPlocale"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/wins(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/checkout",
      "regex": "^/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout(?:/)?$"
    },
    {
      "page": "/checkout/cancel",
      "regex": "^/checkout/cancel(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout/cancel(?:/)?$"
    },
    {
      "page": "/checkout/success",
      "regex": "^/checkout/success(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout/success(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}