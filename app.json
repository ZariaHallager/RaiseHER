{
  "expo": {
    "name": "RaiseHER",
    "slug": "raiseher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "raiseher",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raiseher.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "RaiseHER uses your microphone for salary negotiation rehearsal practice sessions."
      }
    },
    "android": {
      "package": "com.raiseher.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F0EB"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-localization"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
